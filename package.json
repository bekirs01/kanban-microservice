{
  "name": "my-turborepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "bash scripts/dev-frontend.sh",
    "dev:turbo": "turbo run dev",
    "docker:clear-cache": "bash scripts/docker-clear-builder-cache.sh",
    "compose": "bash scripts/docker-compose.sh",
    "colima:reset": "bash scripts/colima-reset-vm.sh",
    "dev:backend": "bash scripts/dev-backend.sh",
    "sync:railway-env": "node scripts/sync-railway-db-env.mjs",
    "repair:railway-migrations": "node scripts/repair-railway-migration-metadata.mjs",
    "dev:railway-db": "bash scripts/dev-backend-railway-db.sh",
    "dev:backend:railway-db": "bash scripts/dev-backend-railway-db.sh",
    "dev:local-db": "bash scripts/docker-compose.sh up -d --build db rabbitmq auth-service tasks-service notifications-service api-gateway web",
    "dev:frontend": "bash scripts/dev-frontend.sh",
    "dev:gateway": "turbo run dev --filter=@challenge/api-gateway",
    "dev:auth": "turbo run dev --filter=@challenge/auth-service",
    "build:types": "turbo run build --filter=@challenge/types",
    "build:exceptions": "turbo run build --filter=@challenge/exceptions",
    "seed": "ts-node scripts/seed.ts",
    "seed:workers": "node scripts/seed-demo-workers.cjs",
    "seed:tasks": "node scripts/seed-demo-tasks.cjs",
    "telegram:test-reminder": "node scripts/telegram-test-reminder.cjs"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.0.3",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "turbo": "^2.6.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "typeorm": "^0.3.28"
  }
}
